generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum EstadoDeuda {
  ACTIVA
  EN_MORA
  AL_DIA
  PAGADA
}

enum EstadoCuota {
  PENDIENTE
  PAGADA
  VENCIDA
}

enum TipoMovimiento {
  PAGO_CUOTA
  ABONO_EXTRAORDINARIO
  PAGO_TOTAL
  AJUSTE_SALDO
  REVERSION_PAGO
}

enum DestinoAbono {
  REDUCIR_CAPITAL
  CUBRIR_MORA
  ADELANTAR_CUOTAS
}

enum PeriodoPresupuesto {
  QUINCENA_1
  QUINCENA_2
  MES_COMPLETO
  DIARIO_VARIABLE
}

enum TipoGasto {
  FIJO
  VARIABLE
  OCASIONAL
}

enum CategoriaGasto {
  VIVIENDA
  SERVICIOS_PUBLICOS
  CONECTIVIDAD
  ALIMENTACION
  TRANSPORTE
  SALUD
  EDUCACION
  ENTRETENIMIENTO
  OTROS
}

model Usuario {
  id        String   @id @default(cuid())
  email     String   @unique
  nombre    String
  password  String
  avatar    String?  @db.LongText
  telefono  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Deuda {
  id                     String        @id @default(cuid())
  entidad                String
  referencia             String?
  montoInicial           Decimal       @db.Decimal(15, 2)
  saldoInicial           Decimal       @db.Decimal(15, 2)
  saldoPendiente         Decimal       @db.Decimal(15, 2)
  valorCuotaMensual      Decimal       @default(0) @db.Decimal(15, 2)
  cuotasTotales          Int           @default(0)
  cuotasPagadasIniciales Int           @default(0)
  cuotasPendientes       Int           @default(0)
  valorVencidoMora       Decimal       @default(0) @db.Decimal(15, 2)
  cuotasEnMora           Int           @default(0)
  fechaInicio            DateTime?
  diaVencimiento         Int?          @default(5)
  estado                 EstadoDeuda   @default(ACTIVA)
  tieneCuotas            Boolean       @default(true)
  observaciones          String?       @db.Text
  orden                  Int           @default(0)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  cuotas                 Cuota[]
  movimientos            Movimiento[]

  @@index([entidad])
  @@index([estado])
}

model Cuota {
  id               String       @id @default(cuid())
  deudaId          String
  numeroCuota      Int
  valor            Decimal      @db.Decimal(15, 2)
  fechaVencimiento DateTime
  fechaPago        DateTime?
  estado           EstadoCuota  @default(PENDIENTE)
  esMora           Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  deuda            Deuda        @relation(fields: [deudaId], references: [id], onDelete: Cascade)
  movimientos      Movimiento[]

  @@unique([deudaId, numeroCuota])
  @@index([deudaId])
  @@index([estado])
  @@index([fechaVencimiento])
}

model Movimiento {
  id                    String          @id @default(cuid())
  deudaId               String
  cuotaId               String?
  tipo                  TipoMovimiento
  monto                 Decimal         @db.Decimal(15, 2)
  saldoAnterior         Decimal         @db.Decimal(15, 2)
  saldoPosterior        Decimal         @db.Decimal(15, 2)
  fecha                 DateTime        @default(now())
  metodoPago            String?         @default("TRANSFERENCIA")
  referenciaPago        String?
  comprobanteUrl        String?         @db.LongText
  observaciones         String?         @db.Text
  destinoAbono          DestinoAbono?   @default(REDUCIR_CAPITAL)
  estaRevertido         Boolean         @default(false)
  movimientoRevertidoId String?         @unique
  createdAt             DateTime        @default(now())

  deuda                 Deuda           @relation(fields: [deudaId], references: [id], onDelete: Cascade)
  cuota                 Cuota?          @relation(fields: [cuotaId], references: [id], onDelete: SetNull)
  movimientoOriginal    Movimiento?     @relation("Reversiones", fields: [movimientoRevertidoId], references: [id])
  reversion             Movimiento?     @relation("Reversiones")

  @@index([deudaId])
  @@index([cuotaId])
  @@index([fecha])
  @@index([tipo])
}

model Configuracion {
  id                    Int      @id @default(1)
  moneda                String   @default("COP")
  formatoFecha          String   @default("DD/MM/YYYY")
  estrategiaPago        String   @default("BOLA_DE_NIEVE")
  modalidadSalario      String   @default("QUINCENAL") // QUINCENAL, MENSUAL, INDEPENDIENTE
  preferenciasDashboard String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ==========================================
// MÓDULO 2: PRESUPUESTO & FLUJO DE CAJA MENSUAL / QUINCENAL
// ==========================================

model Ingreso {
  id          String             @id @default(cuid())
  descripcion String
  monto       Decimal            @db.Decimal(15, 2)
  periodo     PeriodoPresupuesto @default(QUINCENA_1)
  mes         Int                // 1 a 12
  anio        Int                // Ej: 2026
  fecha       DateTime           @default(now())
  fuente      String?            @default("SALARIO") // SALARIO, HONORARIOS, PRIMA, OTROS
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([mes, anio])
  @@index([periodo])
}

model GastoPresupuesto {
  id                 String             @id @default(cuid())
  nombre             String             // Ej: Alquiler, Plan Móvil, Luz, Agua, etc.
  categoria          CategoriaGasto     @default(OTROS)
  tipo               TipoGasto          @default(FIJO) // FIJO o VARIABLE
  montoPresupuestado Decimal            @db.Decimal(15, 2)
  montoReal          Decimal            @default(0) @db.Decimal(15, 2)
  periodoAsignado    PeriodoPresupuesto @default(MES_COMPLETO)
  diaVencimiento     Int?               @default(15)
  estaPagado         Boolean            @default(false)
  fechaPago          DateTime?
  comprobanteUrl     String?            @db.LongText
  notas              String?            @db.Text
  mes                Int                // 1 a 12
  anio               Int                // Ej: 2026
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([mes, anio])
  @@index([periodoAsignado])
  @@index([categoria])
  @@index([tipo])
  @@index([estaPagado])
}

// ==========================================
// MÓDULO 3: METAS DE AHORRO & RESERVA BANCARIA
// (Seguimiento de saldo sobrante trasladado a cuentas/bolsillos bancarios)
// ==========================================

model MetaAhorro {
  id             String       @id @default(cuid())
  nombre         String       // Ej: Fondo de Emergencia, Cajita Nu 13%, Vacaciones
  montoObjetivo  Decimal      @db.Decimal(15, 2)
  montoActual    Decimal      @default(0) @db.Decimal(15, 2)
  bancoUbicacion String       @default("NEQUI_BOLSILLO") // BANCOLOMBIA, NEQUI_BOLSILLO, NU_CAJITA, LULO_BANK, DAVIPLATA, OTRO_BANCO
  color          String?      @default("#10B981")
  icono          String?      @default("PiggyBank")
  fechaLimite    DateTime?
  estaCompletada Boolean      @default(false)
  notas          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  aportes        AporteMeta[]

  @@index([estaCompletada])
}

model AporteMeta {
  id             String      @id @default(cuid())
  metaId         String
  monto          Decimal     @db.Decimal(15, 2)
  fecha          DateTime    @default(now())
  origen         String?     @default("SOBRANTE_SALARIO") // SOBRANTE_SALARIO, APORTE_EXTRAORDINARIO, AJUSTE
  mes            Int?        // Mes del salario del que provino
  anio           Int?        // Año del salario del que provino
  bancoDetalle   String?     // Cuenta o producto bancario de destino
  notas          String?     @db.Text
  createdAt      DateTime    @default(now())

  meta           MetaAhorro  @relation(fields: [metaId], references: [id], onDelete: Cascade)

  @@index([metaId])
  @@index([fecha])
}
