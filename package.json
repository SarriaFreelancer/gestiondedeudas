{
  "name": "misdeudas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000 --turbopack",
    "build": "prisma generate && next build",
    "db:init": "prisma db push --skip-generate --accept-data-loss && tsx prisma/init-db.ts",
    "start": "prisma db push --skip-generate --accept-data-loss && tsx prisma/init-db.ts && next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.8",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "jose": "^6.2.18",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.77.0",
    "next": "15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.11.0",
    "sweetalert2": "^11.26.25",
    "tailwind-merge": "^3.7.1",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
